# Copy this file to scripts/aws-deploy.env and fill in your own values.
# aws-deploy.sh and aws-teardown.sh read it from ~/homelab/scripts/aws-deploy.env.
# The real file is ignored by Git, so your account details stay on your machine.
VPC_ID=
SUBNET_ID=
IGW_ID=
RTB_ID=
SG_ID=
CLUSTER_ARN=
EXEC_ROLE_ARN=
CHICHI_IP=
CF_URL=
